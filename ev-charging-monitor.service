[Unit]
Description=EV Charging Station Monitoring Service
Documentation=https://github.com/yourusername/ev-charging-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/EV_ChargingStation_Monitoring_System
ExecStart=/home/pi/EV_ChargingStation_Monitoring_System/venv/bin/python /home/pi/EV_ChargingStation_Monitoring_System/app.py
Restart=on-failure
RestartSec=10
StandardOutput=inherit
StandardError=inherit
Environment="PATH=/home/pi/EV_ChargingStation_Monitoring_System/venv/bin"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/pi/EV_ChargingStation_Monitoring_System/data

[Install]
WantedBy=multi-user.target
