# EV Charging Station Monitoring System - Environment Configuration
# Copy this file to .env and fill in your specific values
# IMPORTANT: Never commit .env to Git - it contains sensitive information

# Sensor Configuration
SENSOR_TYPE=simulated              # 'simulated' or 'mcp3008'
SAMPLING_INTERVAL=5.0             # Seconds between sensor readings (5.0s slow simulation, 0.5s fast real hardware)
SIMULATED_SAMPLING_INTERVAL=5.0   # Slow rate for simulation mode testing
REAL_SAMPLING_INTERVAL=0.5        # Fast rate for real MCP3008 hardware sensor

# ADC and Calibration
ADC_REFERENCE_VOLTAGE=3.3          # ADC reference voltage (volts)
VOLTAGE_CALIBRATION_FACTOR=1.0     # Calibration multiplier for voltage
CURRENT_ZERO_OFFSET=0.0            # Current sensor zero offset (amps)
CURRENT_SENSITIVITY=1.0            # Current sensor sensitivity factor

# MCP3008 Channels (Raspberry Pi)
MCP3008_CHANNEL_VOLTAGE=0          # ADC channel for voltage sensor
MCP3008_CHANNEL_CURRENT=1          # ADC channel for current sensor

# ML Model Configuration
ML_MODEL_PATH=models/anomaly_model.pkl
ANOMALY_THRESHOLD=-0.5             # Isolation Forest anomaly score threshold

# Early Warning Thresholds
WARNING_THRESHOLD=-0.2             # Score for warning level
CRITICAL_THRESHOLD=0.8             # Score for critical level
CONSECUTIVE_ANOMALIES_FOR_WARNING=3      # Anomalies before warning
CONSECUTIVE_ANOMALIES_FOR_CRITICAL=10    # Anomalies before critical

# Trend Analysis
TREND_WINDOW_SIZE=10               # Number of readings for trend analysis

# Cache Configuration
CACHE_DIR=data                     # Cache directory
CACHE_MAX_AGE_SECONDS=300.0        # Maximum cache age in seconds

# Data Logging
LOG_DIR=data                       # Log directory
LOG_LEVEL=INFO                     # Logging level (DEBUG, INFO, WARNING, ERROR)

# Email Alert Configuration
EMAIL_ALERT_ENABLED=True          # Enable email alerts (True/False)
SMTP_HOST=smtp.gmail.com           # SMTP server hostname
SMTP_PORT=587                      # SMTP port (usually 587 for TLS)
SMTP_USER=your_email@gmail.com     # SMTP login email
SMTP_PASSWORD=your_app_password    # SMTP password or app-specific password
ALERT_EMAIL_FROM=your_email@gmail.com    # From address for alerts
ALERT_EMAIL_TO=recipient@example.com     # To address for alerts
EMAIL_ALERT_COOLDOWN=300.0         # Seconds between alert emails (cooldown)

# Flask Configuration
FLASK_HOST=0.0.0.0                 # Flask server host
FLASK_PORT=5000                    # Flask server port
FLASK_DEBUG=False                  # Debug mode (never True in production)

# Simulation Mode Configuration
SIMULATION_MODE_NORMAL=stable      # 'stable', 'gradual', or 'abrupt'
SIMULATION_VOLTAGE_BASE=12.0       # Base voltage for simulation
SIMULATION_CURRENT_BASE=7.0        # Base current for simulation
SIMULATION_NOISE_LEVEL=0.1         # Noise level for simulated data

# ===== EMAIL SETUP INSTRUCTIONS =====
# 
# For Gmail:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password as SMTP_PASSWORD
# 4. Do NOT use your regular Gmail password
#
# For other providers:
# 1. Check your provider's documentation for SMTP settings
# 2. Usually port 587 (TLS) or 465 (SSL)
# 3. Generate app-specific passwords if available
#
# NEVER commit passwords to Git!
